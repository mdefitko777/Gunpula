{
  "name": "gunpula",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gunpla catalog data, validation, and reporting tools.",
  "scripts": {
    "validate": "node scripts/validate_catalog.mjs",
    "test:unit": "node scripts/test_collection_store.mjs",
    "stats": "node scripts/catalog_stats.mjs",
    "search": "node scripts/search_kits.mjs",
    "sources": "node scripts/source_coverage.mjs",
    "app": "node scripts/serve_app.mjs",
    "export:grades": "node scripts/export_grades_markdown.mjs",
    "import:bandai": "node scripts/import_bandai_spirits_gunpla.mjs",
    "import:pb": "node scripts/import_premium_bandai_jp.mjs",
    "import:pbandai-manual": "node scripts/import_pbandai_manual_products.mjs",
    "import:collectibles": "node scripts/import_bandai_collectibles.mjs",
    "import:fate": "node scripts/import_goodsmile_fate.mjs",
    "import:pokemon-center": "node scripts/import_pokemon_center_jp.mjs",
    "localize": "node scripts/localize_catalog.mjs",
    "cache:ac-images": "node scripts/cache_ac_images.mjs",
    "cache:catalog-images": "node scripts/cache_catalog_images.mjs",
    "cache:pokemon-images": "node scripts/cache_catalog_images.mjs --franchise=pokemon --repo-assets --rewrite --covers-only",
    "cache:pb-images": "node scripts/cache_catalog_images.mjs --franchise=gundam --premium-bandai --repo-assets --rewrite --covers-only --limit=200",
    "cache:fate-images": "node scripts/cache_catalog_images.mjs --franchise=fate --repo-assets --rewrite --covers-only",
    "cache:important-images": "npm run cache:pokemon-images && npm run cache:ac-images && npm run cache:pb-images && npm run cache:fate-images",
    "check:images": "node scripts/check_image_health.mjs",
    "check:images:pokemon": "node scripts/check_image_health.mjs --franchise=pokemon --local",
    "prune:broken-images": "node scripts/prune_broken_image_urls.mjs",
    "repair:pokemon-images": "npm run cache:pokemon-images && npm run check:images:pokemon && npm run prune:broken-images -- --franchise=pokemon && npm run check:images:pokemon",
    "clean:tamashii-images": "node scripts/clean_tamashii_related_images.mjs",
    "duplicates": "node scripts/find_duplicate_candidates.mjs",
    "audit:gundam-series": "node scripts/audit_gundam_series.mjs",
    "check:sources": "node scripts/check_source_health.mjs",
    "split": "node scripts/split_catalog.mjs",
    "updates": "node scripts/build_update_feed.mjs",
    "market": "node scripts/build_market_data.mjs",
    "market:watch": "node scripts/fetch_wanted_market_listings.mjs",
    "market:all": "npm run market:watch && npm run market",
    "android:status": "node scripts/build_market_data.mjs",
    "android:www": "node scripts/prepare_android_www.mjs",
    "android:sync": "npm run android:www && npx @capacitor/cli sync android",
    "android:add": "npm run android:www && npx @capacitor/cli add android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug",
    "import:data": "npm run import:bandai && npm run import:collectibles && npm run import:pokemon-center && npm run import:fate && npm run import:pbandai-manual && npm run import:pb && npm run localize && npm run check:sources",
    "import:official": "npm run import:data",
    "import:gget": "node scripts/import_gget_units.mjs",
    "map:gget": "node scripts/build_gget_kit_map.mjs",
    "cache:gget-images": "node scripts/cache_gget_images.mjs",
    "import:bbx-db": "node scripts/import_bbx_database.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  }
}
