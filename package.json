{
  "name": "gunpula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gunpla catalog data, validation, and reporting tools.",
  "scripts": {
    "validate": "node scripts/validate_catalog.mjs",
    "stats": "node scripts/catalog_stats.mjs",
    "search": "node scripts/search_kits.mjs",
    "sources": "node scripts/source_coverage.mjs",
    "app": "node scripts/serve_app.mjs",
    "export:grades": "node scripts/export_grades_markdown.mjs",
    "import:bandai": "node scripts/import_bandai_spirits_gunpla.mjs",
    "import:collectibles": "node scripts/import_bandai_collectibles.mjs",
    "localize": "node scripts/localize_catalog.mjs",
    "cache:ac-images": "node scripts/cache_ac_images.mjs",
    "cache:catalog-images": "node scripts/cache_catalog_images.mjs",
    "cache:pokemon-images": "node scripts/cache_catalog_images.mjs --franchise=pokemon --repo-assets --rewrite --covers-only",
    "check:images": "node scripts/check_image_health.mjs",
    "check:images:pokemon": "node scripts/check_image_health.mjs --franchise=pokemon --local",
    "prune:broken-images": "node scripts/prune_broken_image_urls.mjs",
    "repair:pokemon-images": "npm run cache:pokemon-images && npm run check:images:pokemon && npm run prune:broken-images -- --franchise=pokemon && npm run check:images:pokemon",
    "clean:tamashii-images": "node scripts/clean_tamashii_related_images.mjs",
    "duplicates": "node scripts/find_duplicate_candidates.mjs",
    "audit:gundam-series": "node scripts/audit_gundam_series.mjs",
    "updates": "node scripts/build_update_feed.mjs",
    "android:sync": "npx @capacitor/cli sync android",
    "import:official": "npm run import:bandai && npm run import:collectibles && npm run localize && npm run cache:pokemon-images && npm run cache:ac-images"
  }
}
