{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdefitko777/Gunpula/schema/kit.schema.json",
  "title": "Gunpla Kit Record",
  "type": "object",
  "required": [
    "kit_id",
    "franchise",
    "grade_code",
    "subline",
    "scale",
    "names",
    "images",
    "universe",
    "work_title",
    "release_date",
    "price_jpy",
    "is_limited",
    "data_status",
    "source_urls",
    "source_refs",
    "tags",
    "notes"
  ],
  "properties": {
    "kit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+[a-z0-9-]*$"
    },
    "franchise": {
      "type": "string",
      "enum": ["gundam", "armored_core", "pokemon", "beyblade", "fate"],
      "description": "Top-level franchise bucket used by the app."
    },
    "grade_code": {
      "type": "string",
      "description": "Must match one code in data/grades.json."
    },
    "subline": {
      "type": ["string", "null"],
      "description": "More specific label such as HGUC, HGCE, MG Ver.Ka, or PG Unleashed."
    },
    "number": {
      "type": ["string", "null"],
      "description": "Line number when a model line has an official visible sequence number."
    },
    "scale": {
      "type": "string",
      "examples": ["1/144", "1/100", "1/60", "non-scale"]
    },
    "names": {
      "type": "object",
      "required": ["ja", "en", "zh", "ko"],
      "properties": {
        "ja": { "type": ["string", "null"] },
        "en": { "type": ["string", "null"] },
        "zh": { "type": ["string", "null"] },
        "ko": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["box_art_url", "box_art_source_id"],
      "properties": {
        "box_art_url": {
          "type": ["string", "null"],
          "format": "uri-reference"
        },
        "box_art_source_id": {
          "type": ["string", "null"],
          "description": "Must match one source_id in data/sources.json when not null."
        }
      },
      "additionalProperties": false
    },
    "gallery_image_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri-reference" },
      "description": "Official product/gallery image URLs when available. The first item should usually match images.box_art_url."
    },
    "universe": {
      "type": ["string", "null"],
      "description": "UC, CE, AD, Ad Stella, Build, SD, etc."
    },
    "work_title": {
      "type": ["string", "null"],
      "description": "Original work or product campaign title."
    },
    "release_date": {
      "type": ["string", "null"],
      "description": "YYYY, YYYY-MM, or YYYY-MM-DD."
    },
    "price_jpy": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "is_limited": {
      "type": "boolean"
    },
    "data_status": {
      "type": "string",
      "enum": ["seed", "needs_review", "verified", "retired"]
    },
    "source_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "source_refs": {
      "type": "array",
      "description": "Structured source references that explain which source supports which fields.",
      "items": {
        "type": "object",
        "required": ["source_id", "url", "fields", "confidence"],
        "properties": {
          "source_id": {
            "type": "string",
            "description": "Must match one source_id in data/sources.json."
          },
          "url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "fields": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
